# EDI Sandbox Configuration

# Directory paths (relative to sandbox/)
INBOUND_DIR=./inbound
OUTBOUND_DIR=./outbound
TEST_DATA_DIR=./test-data
LOG_DIR=./logs

# Trading partner simulation
# Maps tenant ID → (partner name, ISA sender/receiver IDs)
PARTNER_ACME=ACME-VAN/SPS
PARTNER_NORTHSTAR=NSAP-EDI/OpenText
PARTNER_HARBORLITE=HLE-EDI/Cleo
PARTNER_VERDANT=VRDN-EDI/SPS

# WMS sender ID (your 3PL identifier)
WMS_SENDER_ID=AZUX3PLWMS
WMS_RECEIVER_ID=AZUX3PLWMS

# Control number configuration
ISA_CONTROL_START=000050000
GS_CONTROL_START=00001

# API endpoint configuration
# In dev, these point to localhost. In real integration, they point to your WMS API.
WMS_API_BASE=http://localhost:3000/api
WMS_API_KEY=dev-key-change-me

# Mode: "mock" (no real API calls) or "live" (calls real API)
SANDDBOX_MODE=mock

# Auto-start file watcher
AUTO_WATCH=true

# Log level: debug | info | warn | error
LOG_LEVEL=debug